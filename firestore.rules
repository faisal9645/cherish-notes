rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    // Only the user themselves can update their profile or delete it.
    // Authenticated users can read their partner's presence/profile.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Conversations Collection
    // Only the 2 registered participants can read and write to the conversation.
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Couples Collection (Memories, Milestones, Notes)
    match /couples/{coupleId} {
      allow read, write: if isAuthenticated();

      match /memories/{memoryId} {
        allow read, write: if isAuthenticated();
      }

      match /importantDates/{dateId} {
        allow read, write: if isAuthenticated();
      }

      match /sharedNotes/{noteId} {
        allow read, write: if isAuthenticated();
      }

      // Love Synchronicity: only this couple's own phones. The app adds each phone's sign-in id
      // to the couple's "memberUids" list the first time it opens Love Synchronicity.
      function isCoupleMember() {
        return isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.get('memberUids', []);
      }

      function isValidMoment(data) {
        return data.keys().hasAll(['id', 'pattern', 'note', 'createdBy', 'authUid', 'createdAt', 'clientCreatedAt', 'seenAt', 'periodDate', 'periodMonth'])
          && data.keys().hasOnly(['id', 'pattern', 'note', 'createdBy', 'authUid', 'createdAt', 'clientCreatedAt', 'seenAt', 'periodDate', 'periodMonth', 'timeZone', 'editedAt'])
          && data.pattern is string && data.pattern.size() >= 2 && data.pattern.size() <= 6
          && data.note is string && data.note.size() <= 1000
          && data.createdBy is string && data.createdBy.size() > 0
          && data.clientCreatedAt is int && data.seenAt is int
          && data.periodMonth is string && data.periodMonth.matches('^[0-9]{4}-[0-9]{2}$')
          && data.periodDate is string && data.periodDate.matches('^' + data.periodMonth + '-[0-9]{2}$');
      }

      match /synchronicity/{momentId} {
        allow read: if isCoupleMember();
        allow create: if isCoupleMember()
          && request.resource.data.id == momentId
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && isValidMoment(request.resource.data);
        // Later changes: the number, when it was seen (and so its day) and the note
        allow update: if isCoupleMember()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pattern', 'note', 'seenAt', 'periodDate', 'periodMonth', 'editedAt'])
          && isValidMoment(request.resource.data);
        allow delete: if isCoupleMember();
      }
    }
  }
}
