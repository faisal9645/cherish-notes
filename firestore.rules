rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.get('memberUids', []);
    }

    // Users Collection
    // Only accessible if the user belongs to the caller's couple, or is the user themselves.
    // Listing all users across couples is blocked.
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.coupleId != null && isCoupleMember(resource.data.coupleId))
      );
      allow list: if isAuthenticated() && (
        resource.data.coupleId != null && isCoupleMember(resource.data.coupleId)
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (request.resource.data.coupleId != null && isCoupleMember(request.resource.data.coupleId))
      );
      allow delete: if false;
    }

    // Conversations Collection (Chat messages and media)
    // conversationId is the coupleId. Only that couple's own devices can read/write.
    // Listing all conversations is completely blocked.
    match /conversations/{conversationId} {
      allow get: if isCoupleMember(conversationId);
      allow list: if false;
      allow create, update: if isCoupleMember(conversationId);
      allow delete: if false;

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if isCoupleMember(conversationId);
      }
    }

    // Couples Collection (Memories, Milestones, Notes, Calls)
    // Listing all couples is completely blocked.
    // Creation and deletion are ONLY permitted via Cloud Functions (Admin SDK).
    // Updates from phones are only allowed for couple members (excluding memberUids, secretCode, partner IDs).
    match /couples/{coupleId} {
      allow get: if isCoupleMember(coupleId);
      allow list: if false;
      allow create, delete: if false;
      allow update: if isCoupleMember(coupleId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids', 'secretCode', 'partner1Id', 'partner2Id']);

      match /memories/{memoryId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /importantDates/{dateId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /sharedNotes/{noteId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      function isValidMoment(data) {
        return data.keys().hasAll(['id', 'pattern', 'note', 'createdBy', 'authUid', 'createdAt', 'clientCreatedAt', 'seenAt', 'periodDate', 'periodMonth'])
          && data.keys().hasOnly(['id', 'pattern', 'note', 'createdBy', 'authUid', 'createdAt', 'clientCreatedAt', 'seenAt', 'periodDate', 'periodMonth', 'timeZone', 'editedAt'])
          && data.pattern is string && data.pattern.size() >= 2 && data.pattern.size() <= 6
          && data.note is string && data.note.size() <= 1000
          && data.createdBy is string && data.createdBy.size() > 0
          && data.clientCreatedAt is int && data.seenAt is int
          && data.periodMonth is string && data.periodMonth.matches('^[0-9]{4}-[0-9]{2}$')
          && data.periodDate is string && data.periodDate.matches('^' + data.periodMonth + '-[0-9]{2}$');
      }

      match /synchronicity/{momentId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.id == momentId
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && isValidMoment(request.resource.data);
        allow update: if isCoupleMember(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pattern', 'note', 'seenAt', 'periodDate', 'periodMonth', 'editedAt'])
          && isValidMoment(request.resource.data);
        allow delete: if isCoupleMember(coupleId);
      }

      // Voice calls and their recording status: only the backend (Cloud Functions) writes them,
      // and only this couple's own phones can read them
      match /calls/{callId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }

      // Which call is going on right now (for "busy" and for ringing while the app is open)
      match /callControl/{docId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }
    }

    // The backend's own call bookkeeping (Agora's recording session ids, webhook deliveries):
    // no phone can read or write it
    match /callJobs/{callId} {
      allow read, write: if false;
    }

    match /callWebhookEvents/{noticeId} {
      allow read, write: if false;
    }
  }
}
