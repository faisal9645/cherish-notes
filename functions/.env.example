# Agora credentials for 1:1 Voice Calling (Agora Console -> Project Management)
# AGORA_APP_ID is your 32-character Project App ID
AGORA_APP_ID=your_agora_app_id_here

# AGORA_APP_CERTIFICATE is your 32-character Primary Certificate (Project Config -> Enable App Certificate)
# In production with Secret Manager, this is managed via `firebase functions:secrets:set AGORA_APP_CERTIFICATE`
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
