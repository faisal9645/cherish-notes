<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. The system draws this over a 288dp area but only shows the central
     192dp circle, so splash_logo (generated by make_splash.py) keeps the whole rounded-square logo
     inside that circle. Stretched to fill: a fixed size here would push the corners outside the
     circle and the logo would look round again. Same image for day and night. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/splash_logo"
    android:gravity="fill"
    android:filter="true" />
