<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <!-- The app draws its own dark mode: the phone mustn't darken it again (it turned light
             cards black on phones with "dark mode for apps") -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:colorBackground">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ Splash Screen in Dark / AMOLED Mode (Notes only) -->
        <item name="android:windowSplashScreenBackground">#121212</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>

    <!-- Calculator Disguise: opens immediately without splash screen like original Samsung Calculator -->
    <style name="Theme.MyApplication.Calculator" parent="Theme.MyApplication">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_neutral</item>
    </style>
</resources>
