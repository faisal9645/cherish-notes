<?xml version="1.0" encoding="utf-8"?>
<!-- The Calculator icon as an adaptive icon, like the phone's own: the launcher masks it to its
     shape at full size instead of shrinking it into a frame (what happened with the plain PNG) -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_calculator_launcher_background" />
    <foreground android:drawable="@drawable/ic_calculator_launcher_foreground" />
</adaptive-icon>
