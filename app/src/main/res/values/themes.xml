<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <!-- The app draws its own dark mode: the phone mustn't darken it again (it turned light
             cards black on phones with "dark mode for apps") -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Launch screen of the Calculator (the app's own look): just its background, no logo, so
             it opens straight into the calculator like Samsung's (Notes: NotesSplash, below) -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/splash_icon_neutral</item>
    </style>

    <!-- Launch screen while Notes is the decoy: the Notes logo (MainActivity sets it on Android 13+) -->
    <style name="Theme.MyApplication.NotesSplash" parent="Theme.MyApplication">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/splash_icon</item>
    </style>

    <!-- Calculator Disguise: opens immediately without splash screen like original Samsung Calculator -->
    <style name="Theme.MyApplication.Calculator" parent="Theme.MyApplication">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/splash_icon_neutral</item>
    </style>
</resources>
