rules_version = '2';

// Kept the same as the rules published in the Firebase console (full access, set 2026-10-15), so a
// plain `firebase deploy` doesn't replace them with stricter ones.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
